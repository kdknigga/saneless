[scanner]
host = ""       # SANE network host, leave empty for local
device = ""     # SANE device string, leave empty for auto-detect

[paperless]
url = "http://your-paperless-host:8000"
token = "your-api-token-here"
consume_dir = "/path/to/paperless/consume"

[output]
# web_port = 8080       # bare metal only; in Docker remap with -p
# tmp_dir = "/tmp/saneless"
# log_level = "INFO"     # DEBUG, INFO, WARNING, ERROR or CRITICAL

[profiles.default]
source = "Flatbed"
resolution = 300
mode = "color"
# default_tags = []
# default_correspondent = 1
# title = ""   # literal default title, used when the title is left blank
