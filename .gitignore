# Only what this project produces. Patterns that name a directory at the
# repository root start with "/" so they cannot match a package or template
# directory of the same name deeper in the tree. Comments go on their own
# lines: git reads a trailing "# ..." as part of the pattern.

# Python bytecode and packaging
__pycache__/
*.py[cod]
*.so
/build/
/dist/
*.egg-info/

# Environments and tool caches
/.venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Secrets and local configuration (these can hold a live paperless-ngx token)
.env
/saneless.toml
/config/

# Generated site and browser-test artifacts
/site/
/test-results/
/mutants/
/.playwright-mcp/

# Editors and operating systems
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/

# Agent tooling
/.serena/
/.claude/worktrees/
/CLAUDE.md
